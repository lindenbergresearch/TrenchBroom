#version 120
uniform float Width;
uniform float ArrowSize;
uniform float Spacing;
uniform float Phase;
uniform float Alpha;
uniform float MaxDistance;
uniform bool IsOrtho;
uniform vec3 CameraPosition;
varying vec2 linkPosition;
varying float linkLength;
varying vec4 linkColor;
varying vec4 worldCoordinates;
void main(){
    float y=abs(linkPosition.y);
    float base=1.0-smoothstep(Width*0.5-0.75,Width*0.5+0.75,y);
    // Each V has its tip in +X: source -> target. Phase changes without rebuilding buffers.
    float x=mod(linkPosition.x-Phase+Spacing*0.5,Spacing)-Spacing*0.5;
    float arrowDistance=abs(x+y*1.5)/sqrt(3.25)-Width*0.5;
    float arrow=(1.0-smoothstep(-0.75,0.75,arrowDistance))*(1.0-smoothstep(ArrowSize*0.5-0.75,ArrowSize*0.5+0.75,y));
    float caps=smoothstep(-0.75,0.75,linkPosition.x)*(1.0-smoothstep(linkLength-0.75,linkLength+0.75,linkPosition.x));
    float coverage=max(base*0.45,arrow)*caps;
    if(!IsOrtho && MaxDistance>0.0){
        float distanceToCamera=length(worldCoordinates.xyz/worldCoordinates.w-CameraPosition);
        coverage*=1.0-smoothstep(MaxDistance*0.8,MaxDistance,distanceToCamera);
    }
    if(coverage<=0.001)discard;
    gl_FragColor=vec4(linkColor.rgb,linkColor.a*Alpha*coverage);
}
