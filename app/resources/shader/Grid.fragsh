// Derivatives convert distance to the nearest grid line into physical pixels.
// Euclidean gradient length keeps diagonal lines as wide as horizontal lines.
float gridAxis(float coord, float spacing, float pixelFootprint, float width) {
    float distanceToLine = abs(fract(coord / spacing + 0.5) - 0.5) * spacing;
    float pixelDistance = distanceToLine / max(pixelFootprint, 0.000001);
    return 1.0 - smoothstep(width * 0.5 - 0.75, width * 0.5 + 0.75, pixelDistance);
}

uniform float GridAxisColorMix;
uniform vec4 GridXAxisColor;
uniform vec4 GridYAxisColor;
uniform vec4 GridZAxisColor;

vec2 gridLevel(vec2 coords, float spacing, vec2 footprint, float width) {
    return vec2(gridAxis(coords.x, spacing, footprint.x, width),
                gridAxis(coords.y, spacing, footprint.y, width));
}

float lineUnion(vec2 coverage) {
    return max(coverage.x, coverage.y);
}

vec3 axisColorForDirection(vec3 direction) {
    vec3 weights = direction * direction;
    return (weights.x * GridXAxisColor.rgb + weights.y * GridYAxisColor.rgb
        + weights.z * GridZAxisColor.rgb) / max(dot(weights, vec3(1.0)), 0.000001);
}

vec4 sampleGrid(vec3 coords, vec3 normal, float gridSize, float minGridSize,
    float lineWidth, float majorDivisionSize, vec3 baseColor) {
    if (gridSize <= 0.0 || lineWidth <= 0.0)
        return vec4(baseColor, 0.0);

    vec2 plane = coords.xy;
    vec3 u = vec3(1.0, 0.0, 0.0);
    vec3 v = vec3(0.0, 1.0, 0.0);
    vec3 n = abs(normal);
    if (n.x > n.y && n.x > n.z) {
        plane = coords.yz;
        u = v;
        v = vec3(0.0, 0.0, 1.0);
    } else if (n.y > n.z) {
        plane = coords.xz;
        v = vec3(0.0, 0.0, 1.0);
    }

    vec2 dx = dFdx(plane);
    vec2 dy = dFdy(plane);
    vec2 footprint = vec2(length(vec2(dx.x, dy.x)), length(vec2(dx.y, dy.y)));
    float maxFootprint = max(footprint.x, footprint.y);

    // Preserve the existing grid coverage and track each line family separately for color.
    float desiredSpacing = max(minGridSize, maxFootprint * 6.0);
    float level = max(0.0, log2(max(desiredSpacing / gridSize, 1.0)));
    float baseSpacing = gridSize * exp2(floor(level));
    float nextSpacing = baseSpacing * 2.0;
    float blend = smoothstep(baseSpacing, nextSpacing, desiredSpacing);
    vec2 fine = gridLevel(plane, baseSpacing, footprint, lineWidth);
    vec2 coarse = gridLevel(plane, nextSpacing, footprint, lineWidth);
    vec2 lines = mix(fine, coarse, blend);
    float coverage = mix(lineUnion(fine), lineUnion(coarse), blend);

    if (majorDivisionSize > 0.0) {
        vec2 major = gridLevel(plane, majorDivisionSize, footprint, lineWidth * 1.35);
        float visibility = smoothstep(3.0, 6.0, majorDivisionSize / max(maxFootprint, 0.000001));
        lines = max(lines * 0.7, major * visibility);
        coverage = max(coverage * 0.7, lineUnion(major) * visibility);
    }

    vec3 color = baseColor;
    if (GridAxisColorMix > 0.0 && coverage > 0.0) {
        // The line at constant U follows the intersection of the face with a U plane.
        // On sloping faces this naturally blends the axes of its world-space tangent.
        vec3 first = axisColorForDirection(cross(normal, u));
        vec3 second = axisColorForDirection(cross(normal, v));
        vec3 axisColor = (lines.x * first + lines.y * second) / max(lines.x + lines.y, 0.000001);
        color = mix(baseColor, axisColor, GridAxisColorMix);
    }
    return vec4(color, clamp(coverage, 0.0, 1.0));
}
