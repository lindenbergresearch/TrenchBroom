uniform bool EnableLighting;
vec3 previewLighting(vec3 position, vec3 normal);
vec3 previewLightResponse(vec3 light);
uniform bool UsePreviewLightmap;
uniform bool PreviewFullbright;
uniform sampler2D PreviewLightmap;

uniform float Brightness;
uniform float Alpha;
uniform bool EnableMasked;
uniform bool ApplyTexture;
uniform sampler2D Texture;
uniform bool RenderSky;
vec3 sampleSky(vec3 worldDirection);
uniform bool ApplyTinting;
uniform vec4 TintColor;
uniform bool GrayScale;
uniform bool RenderGrid;
uniform float GridSize;
uniform float GridAlpha;
uniform float MajorDivisionSize;
uniform vec3 GridColor;
uniform vec3 CameraPosition;

// shading
uniform bool ShadeFaces;
uniform bool ShadeGrid;
uniform float ShadeLevel;

// fog parameter
uniform bool ShowFog;
uniform vec4 FogColor;
uniform float FogMaxAmount;
uniform float FogMinDistance;
uniform float FogScale;
uniform float FogBias;
uniform int FogType;

uniform int AutoBrightnessType;
uniform float GridLineWidth;
uniform float DpiScale;

varying vec4 modelCoordinates;
varying vec3 modelNormal;
varying vec4 faceColor;
varying vec3 viewVector;

vec4 sampleGrid(vec3 coords, vec3 normal, float gridSize, float minGridSize, float lineWidth, float majorDivisionSize, vec3 baseColor);
float angularShade(vec3 viewVector, vec3 normal, float strength);
vec3 applySoftMapBoundsTint(vec3 inputFragColor, vec3 worldCoords);

void main() {
    if (RenderSky) {
        gl_FragColor = vec4(sampleSky(modelCoordinates.xyz - CameraPosition), 1.0);
    }
    else if (ApplyTexture) {
        gl_FragColor = texture2D(Texture, gl_TexCoord[0].st);
    }
    else {
        gl_FragColor = faceColor;
    }

    // Assume alpha masked or opaque.
    // TODO: Make this optional if we gain support for translucent textures
    if (!RenderSky && EnableMasked && gl_FragColor.a < 0.5f) {
        discard;
    }

    if (!RenderSky && EnableLighting) {
        vec3 light = UsePreviewLightmap
            ? (PreviewFullbright ? vec3(1.0) : previewLightResponse(texture2D(PreviewLightmap, gl_TexCoord[1].st).rgb * 255.0))
            : previewLighting(modelCoordinates.xyz, modelNormal);
        gl_FragColor.rgb *= light;
    }
    if (!RenderSky) gl_FragColor.rgb *= Brightness;

    gl_FragColor = clamp(gl_FragColor, 0.0f, 2.0f);
    gl_FragColor.a = Alpha;

    if (GrayScale) {
        float gray = dot(gl_FragColor.rgb, vec3(0.299f, 0.587f, 0.114f));
        gl_FragColor = vec4(gray, gray, gray, gl_FragColor.a);
    }

    if (ApplyTinting) {
        gl_FragColor = vec4((gl_FragColor.rgb + TintColor.rgb * TintColor.a) * 0.5f, gl_FragColor.a);
        float brightnessCorrection = 1.0f;

        // average color brightness
        if (AutoBrightnessType == 1) {
            float tintBrightness = (abs(TintColor.r) + abs(TintColor.g) + abs(TintColor.b)) / 3.0f;
            if (tintBrightness > 0.00001)
                brightnessCorrection = 0.33f / tintBrightness;
        }

        // peak color brightness
        if (AutoBrightnessType == 2) {
            float tintBrightness = max(max(abs(TintColor.r), abs(TintColor.g)), abs(TintColor.b));
            if (tintBrightness > 0.00001)
                brightnessCorrection = 1.0f / tintBrightness;
        }

        gl_FragColor.rgb = clamp(brightnessCorrection * gl_FragColor.rgb, 0.0f, 2.0f);
    }

    float angleDim = 1.0;
    if (!RenderSky && ShadeFaces && (!EnableLighting || ShadeGrid)) {
        angleDim = angularShade(viewVector, modelNormal, ShadeLevel);
        if (!EnableLighting) gl_FragColor.rgb *= angleDim;
    }

    if (!RenderSky && ShowFog) {
        float distance = length(viewVector);

        vec3 fogColor = FogColor.rgb;
        float maxFogAmount = FogMaxAmount;
        float fogBias = FogBias;
        float fogScale = FogScale;
        float fogMinDistance = FogMinDistance;

        float fogFactor = max(distance - fogMinDistance, 0.0f) * fogScale;

        if (FogType > 0) {
            gl_FragColor.rgb = mix(gl_FragColor.rgb, fogColor, clamp((gl_FragCoord.z / gl_FragCoord.w) * fogScale + fogBias, 0.0f, maxFogAmount));
        }
        else {
            gl_FragColor.rgb = mix(gl_FragColor.rgb, fogColor, clamp(fogFactor + fogBias, 0.0f, maxFogAmount));
        }
    }

    if (!RenderSky && RenderGrid && GridAlpha > 0.0f) {
        vec3 coords = modelCoordinates.xyz;

        // get the maximum distance in world space between this and the neighbouring fragments
        float maxWorldSpaceChange = max(length(dFdx(coords)), length(dFdy(coords)));

        // apply the Nyquist theorem to get the smallest grid size that would make sense to render for this fragment
        float minGridSize = 6.0 * DpiScale * maxWorldSpaceChange;

        vec4 gridSample = sampleGrid(coords, modelNormal.xyz, GridSize, minGridSize, GridLineWidth, MajorDivisionSize, GridColor);
        vec3 gridColor = gridSample.rgb * (ShadeGrid ? angleDim : 1.0);
        gl_FragColor.rgb = mix(gl_FragColor.rgb, gridColor, gridSample.a * GridAlpha);
    }

    gl_FragColor.rgb = applySoftMapBoundsTint(gl_FragColor.rgb, modelCoordinates.xyz);
}
