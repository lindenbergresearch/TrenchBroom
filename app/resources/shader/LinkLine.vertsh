#version 120
uniform vec2 ViewportSize;
uniform float ArrowSize;
uniform float MaxDistance;
uniform vec3 CameraPosition;
uniform bool IsOrtho;
varying vec2 linkPosition;
varying float linkLength;
varying vec4 linkColor;
varying vec4 worldCoordinates;
varying vec2 linkDistance;
bool clipPlane(inout vec4 a,inout vec4 b,inout vec3 wa,inout vec3 wb,float side) {
    float da=a.w+side*a.z, db=b.w+side*b.z;
    if(da<0.0 && db<0.0)return false;
    if(da<0.0){float t=da/(da-db);a=mix(a,b,t);wa=mix(wa,wb,t);}
    else if(db<0.0){float t=da/(da-db);b=mix(a,b,t);wb=mix(wa,wb,t);}
    return true;
}
void main(){
    gl_Position=vec4(2.0,2.0,2.0,1.0);linkPosition=vec2(0.0);linkLength=0.0;linkColor=gl_Color;worldCoordinates=vec4(0.0,0.0,0.0,1.0);
    linkDistance=vec2(0.0,1.0);
    vec3 originalStart=gl_Vertex.xyz,wa=originalStart,wb=gl_Normal;
    // Reject distant connections before rasterization, including long links
    // whose endpoints are far away but whose middle passes near the camera.
    if (!IsOrtho && MaxDistance > 0.0) {
        vec3 line=wb-wa;
        float t=clamp(dot(CameraPosition-wa,line)/max(dot(line,line),0.000001),0.0,1.0);
        vec3 nearest=wa+t*line-CameraPosition;
        if(dot(nearest,nearest)>MaxDistance*MaxDistance)return;
    }
    vec4 a=gl_ProjectionMatrix*gl_ModelViewMatrix*vec4(wa,1.0),b=gl_ProjectionMatrix*gl_ModelViewMatrix*vec4(wb,1.0);
    if(!clipPlane(a,b,wa,wb,1.0)||!clipPlane(a,b,wa,wb,-1.0)||a.w<=0.0||b.w<=0.0)return;
    vec3 start=a.xyz/a.w,end=b.xyz/b.w;
    vec2 delta=(end.xy-start.xy)*ViewportSize*0.5;
    linkLength=length(delta);if(linkLength<0.001)return;
    vec2 direction=delta/linkLength,normal=vec2(-direction.y,direction.x);
    vec2 corner=gl_MultiTexCoord0.xy;bool first=corner.x<0.0;
    float halfWidth=ArrowSize*0.5+2.0;
    linkPosition=vec2(first?-1.0:linkLength+1.0,corner.y*halfWidth);
    gl_Position=vec4(first?start:end,1.0);
    gl_Position.xy+=(direction*corner.x+normal*linkPosition.y)*2.0/ViewportSize;
    float w=first?a.w:b.w;
    worldCoordinates=vec4((first?wa:wb)/w,1.0/w);
    linkDistance=vec2(length((first?wa:wb)-originalStart)/w,1.0/w);
}
