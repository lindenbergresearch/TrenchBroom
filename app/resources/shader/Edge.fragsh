uniform bool ApplyTinting;
uniform vec4 TintColor;

varying vec4 worldCoordinates;
varying vec4 vertexColor;
varying vec2 edgePosition;
varying vec2 edgeExtent;

vec3 applySoftMapBoundsTint(vec3 inputFragColor, vec3 worldCoords);

void main() {
    // Rounded ends close small cracks at joins without native line primitives.
    vec2 distanceToSegment = vec2(max(abs(edgePosition.x) - edgeExtent.x, 0.0), edgePosition.y);
    float distanceToEdge = length(distanceToSegment) - edgeExtent.y;
    float coverage = 1.0 - smoothstep(-0.75, 0.75, distanceToEdge);
    if (coverage <= 0.0)
        discard;
    gl_FragColor = vec4(vertexColor.rgb, vertexColor.a * coverage);

    if (ApplyTinting) {
        gl_FragColor = vec4(gl_FragColor.rgb * TintColor.rgb * TintColor.a, gl_FragColor.a);
        gl_FragColor = clamp(2.0f * gl_FragColor, 0.0f, 1.0f);
    }

    gl_FragColor.rgb = applySoftMapBoundsTint(gl_FragColor.rgb, worldCoordinates.xyz / worldCoordinates.w);
}
