/**
 * TrenchBroom: zentrale Gestaltung der Qt-Oberfläche
 * =================================================
 *
 * Werte: stylesheets/theme.json liefert zusätzliche Farben und Maße. An die
 * Preferences gebundene Werte (z.B. UI-Helligkeit, Schrift, Layer-Iconfarben)
 * kommen aus ThemeManager. Die persönliche theme.json liegt neben Preferences.json.
 * Farben: ${color.name}; logische Pixel: ${length.name}; Faktoren: ${number.name}.
 * Schriftfamilien: ${family.ui}/${family.console}; der Compiler setzt Anführungszeichen.
 * Änderungen dieser Datei werden automatisch geprüft und übernommen.
 *
 * Selektoren lesen:
 *   QToolBar                  alle Toolbars, auch in Dialogen und Werkzeugfenstern
 *   QToolBar#MapFrameToolBar   nur das Widget mit diesem objectName
 *   QWidget[uiTextRole="title"] Widgets mit dieser semantischen Eigenschaft
 *   QToolButton:checked       Zustand, z.B. :hover, :pressed, :disabled, :focus
 *   QSpinBox::up-button       Teil eines Controls, kein eigenständiges Widget
 *   qproperty-iconSize        Qt-Property des genannten Widgets
 * Spezifische Regeln ergänzen die allgemeinen Regeln. Ihre Reihenfolge ist
 * absichtlich erhalten; die späteren Werkzeug-Regeln sind gezielte Ausnahmen.
 *
 * Schnellfinder: sichtbarer Programmteil -> Suchbegriff in dieser Datei
 * ------------------------------------------------------------------
 * Gemeinsame Schriftrollen, Titel, Detailtext  -> TYPOGRAPHY, uiTextRole, uiEmphasized
 * Fonts/Farben einzelner Tabellenzellen        -> ITEM CELL STYLES, ItemCellStyle
 * Konsole und Compiler-Meldungen               -> CONSOLE AND PROCESS OUTPUT, SemanticTextEdit
 * Trennlinien, Panel-Rahmen, Tab-Markierung     -> SEPARATORS, BorderPanel, TabSelectionIndicator
 * Farbverlauf im Property-Smart-Editor          -> ColorTable
 * Untere Statusleiste des MapEditors           -> STATUSBAR, StatusBar_RightLayout
 * Linke/rechte Inspector-Bereiche              -> INSPECTOR, Inspector_LeftStack
 * Docking-Titel und schwebende Werkzeuge       -> INSPECTOR HEADERS, InspectorToolTitle
 * Tabs zusammengefasster Inspector-Werkzeuge   -> InspectorToolTabs
 * Werkzeugleisten unter den Titeln             -> InspectorToolToolbar, inspectorToolbar
 * Layer-Baum: Zeilen, Details, Sperren         -> LAYER TREE, LayerTreeRow
 * Layer-Baum: Aufklapp-Pfeile, Icongrößen      -> LayerTree, branchIndicatorSize
 * Games-/Such-/Preferences-Listen              -> LIST ROWS, preferencesList
 * Prefab-Baum, Kacheln, Beschriftungen         -> PREFAB BROWSER, PrefabTiles, PrefabCard
 * Auswahlfelder, Checkboxen, Zahlenfelder      -> COMBO-BOX, CHECKBOX, EDIT FIELD
 * Durchsuchbare Command-/Action-Auswahl        -> SearchableComboPopup, searchable
 * Haupt-Toolbar des Editorfensters             -> TOOLBAR, MapFrameToolBar
 * Kontextmenüs und Hilfetexte                  -> MENU, TOOLTIP
 * Scrollleisten und Trennlinien                -> SCROLL BAR, SPLITTER
 * Preferences Editor Actions/Editor Toolbar    -> EDITOR CUSTOMIZATION PREFERENCES
 * View Settings aus dem MapEditor              -> VIEW SETTINGS, ViewEditor
 * Parameter der Brush-Formen über dem Editor   -> BRUSH SHAPE TOOL, ShapeToolPage
 * Toolbars im MapEditor an allen vier Kanten   -> MAPEDITOR TOOLBARS, EditorToolbar
 * Quelltext-Dialog für ausgewählte Objekte     -> OBJECT SOURCE VIEWER, nodeSourceText
 * Kompilier-Aufgaben und Crash-Dialog          -> SPECIALIZED WIDGETS, CompilationTaskCard
 * Helligkeit/Abdunklung aller SVG-Icons        -> IconAppearance
 *
 * Die 3D-Szene (Grid, Brushes, Selection Bounds) wird über Renderer und View Settings
 * gestaltet. Das Zustands-Overlay im 3D-Editor besitzt zusätzlich seine eigene
 * Theme-Konfiguration und QSS-Datei; siehe doc/Theme-Verwaltung.md.
 */

/* ==== OBJECT SOURCE VIEWER ==== */
/* Read-only-Dialog aus dem Layer-Inspektor: Map-Ausschnitt bzw. Entity-Definition.
   nodeSourceText ist der Textbereich; die qproperty-...Color-Werte steuern dessen
   Syntax-Highlighting. nodeSourceLocation ist die Quellen-/Positionszeile. */
QDialog#nodeSourceDialog {
    background-color: ${color.window};
}

QLabel#nodeSourceLocation {
    color: ${color.text.detail};
    font-size: ${length.font.small};
}

/* Override font family/size and all syntax colors here. The shared console
   font is the default; no text or background colors are set in C++. */
QPlainTextEdit#nodeSourceText {
    font-family: ${family.console};
    font-size: ${length.font.console};
    color: ${color.text};
    background-color: ${color.source.background};
    selection-background-color: ${color.source.selection.background};
    selection-color: ${color.source.selection.text};
    border: 1px solid ${color.source.border};
    border-radius: 4px;
    padding: 8px;
    qproperty-keywordColor: ${color.syntax.keyword};
    qproperty-stringColor: ${color.syntax.string};
    qproperty-numberColor: ${color.syntax.number};
    qproperty-commentColor: ${color.syntax.comment};
    qproperty-propertyColor: ${color.syntax.property};
}

/* ==== ITEM CELL STYLES ==== */
/* Property/Preferences/Colors/Issues tables share one hidden proxy per cell role.
   cellContext: entityProperties/preferences/colors/issues; cellRole: key/value/
   hidden. cellStates contains default/readonly/mixed/subset for entity properties.
   Font changes apply to existing rows. Optional
   qproperty-overrideTextColor: true lets `color` override the model's foreground;
   keep it false for cells whose color represents data, such as color preferences. */
QWidget#ItemCellStyle,
QWidget#StyledCellEditor {
    font-family: ${family.ui};
    font-size: ${length.font.ui};
    font-weight: ${weight.ui};
    font-style: ${keyword.font.ui};
}
QWidget#ItemCellStyle[cellContext="entityProperties"],
QWidget#StyledCellEditor[cellContext="entityProperties"] {
    color: ${color.text.highlighted};
}
QWidget#ItemCellStyle[cellContext="entityProperties"][cellRole="key"],
QWidget#StyledCellEditor[cellContext="entityProperties"][cellRole="key"] { font-weight: bold; }
QWidget#ItemCellStyle[cellContext="entityProperties"][cellRole="value"],
QWidget#StyledCellEditor[cellContext="entityProperties"][cellRole="value"] { color: ${color.text}; }
QWidget#ItemCellStyle[cellContext="entityProperties"][cellStates~="readonly"],
QWidget#StyledCellEditor[cellContext="entityProperties"][cellStates~="readonly"] { font-style: italic; font-weight: normal; }
QWidget#ItemCellStyle[cellContext="entityProperties"][cellRole="value"][cellStates~="mixed"],
QWidget#StyledCellEditor[cellContext="entityProperties"][cellRole="value"][cellStates~="mixed"] { color: ${color.highlight}; font-weight: normal; }
QWidget#ItemCellStyle[cellContext="entityProperties"][cellStates~="subset"],
QWidget#StyledCellEditor[cellContext="entityProperties"][cellStates~="subset"] { color: ${color.text.disabled}; }
QWidget#ItemCellStyle[cellContext="entityProperties"][cellStates~="default"],
QWidget#StyledCellEditor[cellContext="entityProperties"][cellStates~="default"] {
    color: ${color.text.disabled}; font-style: normal; font-weight: normal;
}
QWidget#ItemCellStyle[cellContext="issues"][cellRole="hidden"],
QWidget#StyledCellEditor[cellContext="issues"][cellRole="hidden"] { font-style: italic; }
QWidget#ItemCellStyle[cellContext="preferences"][cellRole="value"],
QWidget#StyledCellEditor[cellContext="preferences"][cellRole="value"],
QWidget#ItemCellStyle[cellContext="colors"][cellRole="value"],
QWidget#StyledCellEditor[cellContext="colors"][cellRole="value"] {
    font-family: ${family.console};
}

QWidget#ItemCellStyle { qproperty-overrideTextColor: false; }
QWidget#ItemCellStyle[cellContext="entityProperties"] { qproperty-overrideTextColor: true; }

/* ==== TYPOGRAPHY ==== */
/* Gemeinsame Rollen für QtUtils::makeTitle/makeInfo/makeSmall/makeMono usw.
   uiTextRole: small/info/subtitle/title/header/dialogTitle/brand.
   uiEmphasized und uiItalic steuern Gewicht und Kursivschrift; uiFontFamily="console"
   wechselt zum Console-Font. uiSurface färbt Container. Schriftgrößen in ThemeManager
   berücksichtigen die in Preferences -> View gewählte Mindestgröße. */
*[uiStyled="true"] {
    font-family: ${family.ui};
    font-size: ${length.font.ui};
    font-weight: ${weight.ui};
    font-style: ${keyword.font.ui};
}

*[uiFontFamily="console"] {
    font-family: ${family.console};
    font-size: ${length.font.console};
    font-weight: ${weight.console};
    font-style: ${keyword.font.console};
}

*[uiTextRole="small"], *[uiTextRole="info"] {
    font-size: ${length.font.small};
}

*[uiTextRole="info"] {
    color: ${color.text.detail};
}

*[uiTextRole="subtitle"] {
    font-size: ${length.font.subtitle};
}

*[uiTextRole="title"] {
    font-size: ${length.font.title};
    color: ${color.text.highlighted};
}

*[uiTextRole="header"] {
    font-size: ${length.font.header};
    color: ${color.text.highlighted};
}

*[uiTextRole="dialogTitle"] {
    font-size: ${length.font.dialogTitle};
    font-weight: bold;
    color: ${color.text.highlighted};
}

*[uiTextRole="brand"] {
    font-family: "Rabanera";
    font-size: 32px;
    color: ${color.text.highlighted};
}

*[uiEmphasized="true"] {
    font-weight: bold;
}

*[uiEmphasized="false"] {
    font-weight: normal;
}

*[uiItalic="true"] {
    font-style: italic;
}

*[uiItalic="false"] {
    font-style: normal;
}

*[uiTone="normal"] {
    color: ${color.text};
}

*[uiTone="highlighted"] {
    color: ${color.text.highlighted};
}

*[uiTone="error"] {
    color: ${color.error};
}

*[uiStyled="true"]:disabled {
    color: ${color.text.disabled};
}

*[uiSurface="window"] {
    background-color: ${color.window};
}

*[uiSurface="base"] {
    background-color: ${color.base};
}

*[uiSurface="highlight"] {
    background-color: ${color.highlight};
}

/* ==== WINDOW AND STATUS BAR ==== */
QMainWindow#MapFrame {
    min-width: 1280px;
    min-height: 768px;
}

/* ==== STATUSBAR ==== */

QStatusBar {
    margin-top: 0px;
    margin-bottom: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
    border-top: 1px solid ${color.midlight};
    background: ${color.window};
    min-height: 26px;
    background-color: ${color.window};
}

QWidget#StatusBar_RightLayout {
    border-left: 2px solid ${color.midlight};
    text-align: left;
    padding: 0px;
    padding-left: 0px;
    margin-right: 0px;
}

QWidget#StatusBar_LeftLayout {
    border-right: 2px solid ${color.midlight};
    text-align: left;
    padding-right: 0px;
    padding: 0px;
    margin-left: 0px;
}

QWidget#StatusBar_CenterLayout {
    border: none;
    text-align: center;
    padding: 0px;
}

QWidget#StatusBarWidget {
    border: none;
    margin: 0px;
    color: ${color.text};
    font-size: ${length.font.subtitle};
    text-align: center;
}

/* ==== INSPECTOR ==== */
/* Container für die links/rechts angedockten Werkzeugstapel. Abstände und Flächen
   werden hier gestaltet; Titel, Werkzeugleisten und Tabs haben eigene Regeln unten. */

QWidget#Inspector_LeftStack, QWidget#Inspector_RightStack {
    margin: 0px;
    padding: 0px;
    border: none;
}

QWidget#Inspector_Widget, QWidget#Inspector_LeftPane {
    margin: 0px;
    padding: 0px;
    border: none;
}

/* ==== LIST/TABLE ==== */
/* Gemeinsame Tabellenköpfe, z.B. Properties und Shortcut-Verwaltung. Die eigentlichen
   Listeneinträge folgen unter LIST ROWS; der Layer-Baum zeichnet seine Zeilen selbst. */

QHeaderView {
    background-color: ${color.midlight};
    color: ${color.text.highlighted};
    font-size: ${length.font.subtitle};
    font-weight: bold;
    min-height: 22px;
}

QHeaderView::section {
    border: 1px solid ${color.dark};
    text-align: center;
}

QHeaderView:disabled {
    background-color: ${color.dark};
}

QTableWidget {
    gridline-color: ${color.midlight};
}

/* ==== LAYER TREE ==== */
/* Werkzeug Layers: hierarchische Einträge für Layer, Gruppen, Entities, Brushes
   und virtuelle Typgruppen. LayerTreeRow ist eine Zeichenvorlage des Delegates;
   es wird nicht für jeden Map-Knoten ein eigenes QWidget erzeugt. */

/* The layer tree paints the selection once across the entire row. */
QTreeWidget#LayerTree {
    show-decoration-selected: 0;
    qproperty-indentation: 16;
    qproperty-iconSize: 13px 13px;
    qproperty-attributeColumnWidth: 22;
    /* Disclosure chevrons; indentation controls their clickable column. */
    qproperty-branchIndicatorSize: 6;
    qproperty-branchIndicatorColor: ${color.light};
    qproperty-branchIndicatorLineWidth: 3.5;
}

QTreeWidget#LayerTree::item,
QTreeWidget#LayerTree::item:hover {
    background: transparent;
    border: none;
}

/* Shared layer-row style templates; no widget is created per map object.
   nodeType: layer, group, entity, brush, patch, typeGroup.
   States: hidden, locked, selected, currentLayer (all true/false).
   Standard font/color/background/border rules and the following layout
   properties apply to the whole row, across all three columns.
   detailOpacity = -1 uses the UI detail-opacity preference; 0..1 overrides it.
   An optional qproperty-detailColor overrides the secondary line's color. */
QWidget#LayerTreeRow {
    color: ${color.text};
    background: transparent;

    border: none;
    border-bottom: 1px solid ${color.window};
    border-radius: 6px;

    qproperty-paddingLeft: 4;
    qproperty-paddingTop: 4;
    qproperty-paddingRight: 4;
    qproperty-paddingBottom: 4;

    qproperty-contentIconSize: 24;
    qproperty-iconSpacing: 4;
    qproperty-lineSpacing: 0;
    qproperty-detailFontReduction: 2;
    qproperty-detailOpacity: -1;
    qproperty-detailColor: ${color.text};
    qproperty-minimumRowHeight: 0;
    qproperty-rowInsetX: 2;
    qproperty-rowInsetY: 1;
}

QWidget#LayerTreeRow[nodeType="layer"] {
    qproperty-paddingTop: 6;
    qproperty-paddingBottom: 6;
}

QWidget#LayerTreeRow[nodeType="entity"] {
    qproperty-paddingTop: 5;
    qproperty-paddingBottom: 5;
}

QWidget#LayerTreeRow[nodeType="brush"], QWidget#LayerTreeRow[nodeType="patch"] {
    qproperty-contentIconSize: 18;
    qproperty-paddingTop: 2;
    qproperty-paddingBottom: 2;
    qproperty-detailFontReduction: 2;
    font-size: ${length.font.small};
    border-radius: 3px;


}

QWidget#LayerTreeRow[currentLayer="true"] {
    font-weight: bold;
}

QWidget#LayerTreeRow[selected="true"] {
    background-color: ${color.highlight};
    color: ${color.text.highlighted};
    qproperty-detailOpacity: 1;
    qproperty-detailColor: ${color.text.highlighted};
}

/* Keep the state recognizable even in the selected row. */
QWidget#LayerTreeRow[hidden="true"] {
    color: ${color.layer.hidden.text};
    qproperty-detailColor: ${color.layer.hidden.text};
    font-style: italic;
}
QWidget#LayerTreeRow[locked="true"] {
    color: ${color.layer.locked.text};
    qproperty-detailColor: ${color.layer.locked.text};
}
QWidget#LayerTreeRow[hidden="true"][locked="true"] {
    color: ${color.layer.hiddenLocked.text};
    qproperty-detailColor: ${color.layer.hiddenLocked.text};
}
QWidget#LayerTreeRow[hidden="true"][selected="true"] {
    color: ${color.layer.hidden.selectedText};
    qproperty-detailColor: ${color.layer.hidden.selectedText};
}
QWidget#LayerTreeRow[locked="true"][selected="true"] {
    color: ${color.layer.locked.selectedText};
    qproperty-detailColor: ${color.layer.locked.selectedText};
}
QWidget#LayerTreeRow[hidden="true"][locked="true"][selected="true"] {
    color: ${color.layer.hiddenLocked.selectedText};
    qproperty-detailColor: ${color.layer.hiddenLocked.selectedText};
}

/* SVG brightness is normalized before the additional disabled-state dimming.
   Brightness and opacity factors are in the range 0..1. */
QWidget#IconAppearance {
    qproperty-normalizeBrightness: true;
    qproperty-brightness: ${number.icon.brightness};
    qproperty-disabledBrightness: ${number.icon.disabledBrightness};
    qproperty-disabledOpacity: ${number.icon.disabledOpacity};
}

/* ==== INSPECTOR HEADERS ==== */
/* InspectorToolTitle: ziehbare Titelleiste eines angedockten Werkzeugs.
   InspectorWindowTitle/InspectorWindowCaption: Leiste eines schwebenden Toolfensters.
   InspectorToolTabs: Tab-Leiste, wenn mehrere Werkzeuge zu einem Stapel gruppiert sind.
   inspectorDropHighlight markiert beim Ziehen das aktuelle Andockziel.
   TitleBar/SubTitleBar bleiben für allgemeine, betitelte Funktionsabschnitte erhalten. */
QWidget#TitleBar {
    background-color: ${color.base};
    border: none;
    color: ${color.text};
    min-height: 20px;
}

QWidget#SubTitleBar {
    background-color: ${color.base};
    color: ${color.text};
    min-height: 20px;
    font-size: ${length.font.small};
}

QLabel#TitleBar_m_titleText {
    color: ${color.text.highlighted};
    qproperty-alignment: AlignCenter;
}

QWidget#SubTitleBar QLabel#TitleBar_m_titleText {
    font-size: ${length.font.small};
}

QLabel#TitleBar_m_titleText[emphasized="true"] {
    font-weight: bold;
}

/* Inspector headers share a height. Tab padding and the underline are included
 * in the tab height below. */
QWidget#InspectorToolTitle,
QWidget#InspectorWindowTitle,
QTabBar#InspectorToolTabs {
    background-color: ${color.base};
    border: none;
    margin: 0px;
    padding: 0;
    min-height: 27px;
    max-height: 27px;
}

QWidget#InspectorToolTitle QLabel#TitleBar_m_titleText,
QLabel#InspectorWindowCaption {
    color: ${color.text.highlighted};
    font-size: ${length.font.subtitle};
    font-weight: bold;
}

QLabel#InspectorWindowCaption {
    padding-left: 8px;
}

QWidget[inspectorDropHighlight="true"] {
    qproperty-windowOpacity: 0.65;
}

QWidget[inspectorDropHighlight="false"] {
    qproperty-windowOpacity: 1;
}

/* ==== LIST ROWS ==== */
/* controlListBox_listWidget wird u.a. unter Preferences -> Games verwendet.
   preferencesList="true" verbindet neue Preferences-Listen mit derselben Fläche.
   ImageListBox-/SearchListBox-Labels sind Haupt-/Detailzeilen älterer Listen-Renderer.
   Die allgemeine Auswahl unten gilt für Item-Views; LayerTreeRow hat eigene Zustände. */

/* Preference lists share the same surface as the Games list. Selection states
   below apply to all item views, including searchable combo-box popups. */
QListWidget#controlListBox_listWidget,
QListWidget[preferencesList="true"] {
    background-color: ${color.base};
    alternate-background-color: ${color.base.alternate};
    color: ${color.text};
}

QAbstractItemView::item:selected:active {
    border-radius: ${length.radius.border};
    border-style: solid;
    background-color: ${color.highlight};
    border-color: ${color.highlight};
    color: ${color.text.highlighted};
}

QAbstractItemView::item:selected:!active {
    border-radius: ${length.radius.border};
    border-width: ${length.border};
    border-style: solid;
    background-color: ${color.highlight.dark};
    border-color: ${color.highlight.dark};
    color: ${color.text.highlighted};
}

QWidget#ImageListBoxItemRenderer_m_titleLabel {
    color: ${color.text.highlighted};
    border: none;
}

QWidget#ImageListBoxItemRenderer_m_subtitleLabel,
QLabel#SearchListBoxItemRenderer_m_infoText {
    color: ${color.text.detail};
    font-size: ${length.font.small};
    border: none;
}

/* ==== PREFAB BROWSER ==== */
/* Prefab-Werkzeug: PrefabTree ist die Baumansicht, PrefabTiles die Ordner-/Kachelansicht.
   PrefabNavigation ist die Navigationszeile. PrefabCard enthält Thumbnail, Namen
   und Maße; [folder="true"] und [selected="true"] unterscheiden Ordner und Auswahl.
   PrefabBrightness... gestaltet die Helligkeitsregler der Prefab-Vorschau. */

/* Prefab browser: cards inherit the configured UI font and scale with previews. */
QTreeWidget#PrefabTree {
    background-color: ${color.base};
    border: none;
    outline: none;
}

QListWidget#PrefabTiles {
    background-color: ${color.base};
    border: none;
    outline: none;
    qproperty-spacing: 6;
}

QListWidget#PrefabTiles::item {
    border: 1px solid transparent;
    border-radius: ${length.radius.border};
}

QListWidget#PrefabTiles::item:hover {
    background-color: ${color.midlight};
}

QListWidget#PrefabTiles::item:selected {
    background-color: ${color.highlight};
    border-color: ${color.highlight.light};
}

QWidget#PrefabNavigation {
    background-color: ${color.window};
    border-bottom: 1px solid ${color.midlight};
}

QFrame#PrefabPreview {
    background-color: ${color.base};
    border: 1px solid ${color.midlight};
    border-radius: ${length.radius.border};
}

QLabel#PrefabPreviewHint {
    color: ${color.text.detail};
    font-size: ${length.font.small};
    background: transparent;
    border: none;
}

QWidget#PrefabBrightnessPanel {
    background: transparent;
    border: none;
}
QLabel#PrefabBrightnessLabel {
    color: ${color.text};
    font-size: ${length.font.small};
    background: transparent;
    border: none;
}

QLabel#PrefabLocation {
    color: ${color.text};
    font-size: ${length.font.subtitle};
    border: none;
    background: transparent;
}

QWidget#PrefabCard {
    background: transparent;
    border: none;
}

QLabel#PrefabThumbnail {
    background-color: ${color.window};
    border: 1px solid ${color.midlight};
    border-radius: ${length.radius.border};
}

QWidget#PrefabCard[folder="true"] QLabel#PrefabThumbnail {
    background: transparent;
    border: none;
}

QWidget#PrefabName {
    color: ${color.text};
    font-size: ${length.font.ui};
    font-weight: bold;
    background: transparent;
    border: none;
}

QWidget#PrefabDimensions, QLabel#PrefabStatus {
    color: ${color.text.detail};
    font-size: ${length.font.small};
    background: transparent;
    border: none;
}

QWidget#PrefabCard[selected="true"] QWidget#PrefabName,
QWidget#PrefabCard[selected="true"] QWidget#PrefabDimensions {
    color: ${color.text.highlighted};
}

/* ==== SPLITTER ==== */
/* Verschiebbare Trennbereiche zwischen Editor-/Inspector- und Preferences-Panes. */

/* ==== SEPARATORS, PANEL BORDERS AND TAB INDICATORS ==== */
/* BorderLine: orientation is horizontal/vertical, separatorWeight normal/strong.
   `thickness` controls its size hint; min-/max-height/width can override it too.
   BorderPanel selects the required edges in C++, while QSS owns width and color. */
QFrame#borderLine {
    border: none;
    background-color: ${color.midlight};
    margin: 0px;
    padding: 0px;
    qproperty-thickness: 1;
}
QFrame#borderLine[separatorWeight="strong"] { qproperty-thickness: 2; }
TrenchBroom--View--BorderPanel {
    background-color: ${color.window};
    qproperty-borderColor: ${color.midlight};
    qproperty-borderWidth: 1;
}
QWidget#TabSelectionIndicator {
    min-height: 6px;
    max-height: 6px;
    background-color: transparent;
}
QWidget#TabSelectionIndicator[selected="true"] { background-color: ${color.highlight}; }

/* ==== SPLITTER ==== */
QSplitter {
    padding: 0px;
    margin: 0px;
    background-color: ${color.dark};
    qproperty-handleWidth: 8;
    border: none;
}

/* Splitter handles: width/background apply to all splitters. The custom editor
   handles additionally expose the color, spacing and diameter of their grip dots. */
QSplitter::handle { background-color: ${color.dark}; }
QSplitter::handle:hover { background-color: ${color.midlight}; }
TrenchBroom--View--SplitterHandle {
    qproperty-gripColor: ${color.mid};
    qproperty-gripSpacing: 5;
    qproperty-gripDotSize: 2;
}

/* ==== CHECKBOX ==== */
/* Alle Checkboxen verwenden diese gemeinsame Basis, auch View und die Editor-
   Konfiguration. entityDefinition_... sind gezielte Ausnahmen der Entity-Auswahl. */

/* All preferences, including the editor customization panes, use this surface. */
QCheckBox {
    background: transparent;
}

QCheckBox#entityDefinition_checkboxWidget {
    margin-left: 16px;
}

QCheckBox#entityDefinition_groupCheckboxWidget {
    margin-left: 0px;
    color: ${color.text.highlighted};
}

/* ==== TEXT-EDIT ==== */

QTextEdit {
    border: none;
    background-color: ${color.shadow};
    padding: 2px;
    margin-top: 2px;
    margin-left: 0px;
    margin-bottom: 2px;
}

/* ==== CONSOLE AND PROCESS OUTPUT ==== */
/* Rich-text logging and compiler system messages use semantic roles. Changing
   these properties also recolors existing tagged messages in small batches.
   Fonts inherit this widget's QSS; ANSI colors from external tools retain their
   original meaning. Log defaults remain connected to Preferences -> Colors. */
TrenchBroom--View--SemanticTextEdit {
    font-family: ${family.console};
    font-size: ${length.font.console};
    color: ${color.text};
    qproperty-traceColor: ${color.log.trace};
    qproperty-debugColor: ${color.log.debug};
    qproperty-infoColor: ${color.log.info};
    qproperty-warningColor: ${color.log.warning};
    qproperty-errorColor: ${color.log.error};
    qproperty-successColor: ${color.text};
    qproperty-systemColor: ${color.text};
    qproperty-systemFontWeight: 75;
}
TrenchBroom--View--SemanticTextEdit#CompilationOutput {
    qproperty-infoColor: #0eceef;
    qproperty-warningColor: #cccd00;
    qproperty-errorColor: #ff3824;
    qproperty-successColor: #00ff00;
}

/* ==== COMBO-BOX ==== */
/* Allgemeine Dropdowns, ihre Popup-Listen und Suchfelder. ToolBar_GridChoice ist
   die Grid-Größe der Haupt-Toolbar; TextureBrowser_smallComboBox ist der kompakte
   Textur-Browser-Filter. Die gefilterte Command-/Action-Suche steht unter EDIT FIELD. */

QComboBox {
    min-height: 16px;
    min-width: 50px;
    padding-right: 8px;
    background-color: ${color.mid};
    border: 1px solid ${color.midlight};
    border-radius: ${length.radius.border};
}

/* The search field is part of its combo, rather than a separately framed
   line edit. Keep this shared so every editable selector uses the same theme. */
QComboBox QLineEdit,
QComboBox QLineEdit:focus,
QAbstractSpinBox QLineEdit,
QAbstractSpinBox QLineEdit:focus {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    min-height: 0;
}

QComboBox#ToolBar_GridChoice {
    min-height: 16px;
    max-height: 18px;
    font-size: ${length.font.small};
    min-width: 100px;
    padding: 1px;
    background-color: ${color.dark};
    border: 1px solid ${color.midlight};
    border-radius: ${length.radius.border};
}

QComboBox#ToolBar_GridChoice::item {
    min-width: 100px;
    padding: 0px;
    margin: 0px;
    font-size: ${length.font.small};
    min-height: 16px;
    max-height: 18px;
}

QComboBox QAbstractItemView {
    padding: 0px;
    margin: 4px;
    border: 1px solid ${color.mid};
    border-radius: ${length.radius.border};
    background-color: ${color.dark};
}

QComboBox::drop-down:active {
    selection-background-color: ${color.highlight};
    min-width: 14px;
}

QComboBox#ToolBar_GridChoice::item:selected:active {
    background-color:  ${color.highlight};
    min-width: 100px;
    min-height: 16px;
    max-height: 18px;
}

QComboBox::drop-down {
    padding-left: 2px;
    min-width: 14px;
    background-color: ${color.midlight};
    border-left: none;
    border-right: 2px solid ${color.midlight};
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: 2px;
    border-top-left-radius: 0px;
}

QComboBox::down-arrow {
    image: url(":down.svg");
    height: 14px;
    width: 14px;
}

QComboBox#TextureBrowser_smallComboBox {
    padding: 3px 3px 3px 2px;
    min-width: 60px;
    min-height: 18px;
}

/* ==== EDIT FIELD ==== */
/* Eingabefelder und Zahlenfelder in allen Dialogen/Inspector-Werkzeugen.
   QAbstractSpinBox umfasst QSpinBox und QDoubleSpinBox. Der innere QLineEdit erbt
   die Fläche des Controls; Fokus/Disabled-Zustände werden hier gemeinsam gestaltet.
   SearchableComboPopup zeigt Command-/Action-Treffer mit Namen und ID; die
   qproperty-match...-Farben markieren den Suchbegriff in beiden Zeilen. */

QLineEdit {
    padding: 2px 0px 2px 2px;
    min-height: 20px;
    border: 1px solid ${color.midlight};
    border-radius: 4px;
}

/* Spin fields share the same input surface in every preferences pane. */
QAbstractSpinBox {
    background-color: ${color.base};
    color: ${color.text};
    padding: 2px;
    min-height: 20px;
    border: 1px solid ${color.midlight};
    border-radius: 4px;
}
QAbstractSpinBox:focus {
    border-color: ${color.highlight};
}
QAbstractSpinBox:disabled {
    background-color: ${color.dark};
    color: ${color.text.disabled};
}
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    border: none;
    border-left: 1px solid ${color.midlight};
    background: transparent;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: ${color.midlight};
}
QAbstractSpinBox::up-arrow { image: url(":up.svg"); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url(":down.svg"); width: 10px; height: 10px; }

/* The searchable selectors use one filtered popup for typing and the arrow. */
QComboBox[searchable="true"] {
    qproperty-matchForeground: ${color.text.highlighted};
    qproperty-matchBackground: ${color.midlight};
}
QListView#SearchableComboPopup {
    background-color: ${color.base};
    color: ${color.text};
    selection-background-color: ${color.highlight};
    selection-color: ${color.text.highlighted};
    border: 1px solid ${color.midlight};
    border-radius: ${length.radius.border};
    min-width: 360px;
    max-width: 720px;
}
QListView#SearchableComboPopup::item {
    padding: 2px 4px;
    border-radius: ${length.radius.border};
}

QLineEdit:focus {
    border: 1px solid ${color.highlight};
}

QLineEdit:disabled {
    background-color: ${color.dark};
    color: ${color.text.disabled};
}

QWidget#MapPropertiesEditor {
    background-color: ${color.window};
    font-size: ${length.font.subtitle};
}

/* ==== TOOLBAR ==== */
/* MapFrameToolBar ist die obere Haupt-Toolbar. ToolBar_PreferenceDialog enthält
   die Preferences-Kategorien. InspectorToolToolbar und inspectorToolbar="true"
   teilen die Gestaltung für Inspector- und Konfigurations-Werkzeugleisten;
   deren Button-Zustände stehen zusätzlich unter TOOLBUTTON. */

QToolBar {
    border: none;
    border-bottom: 1px solid ${color.light};
    margin: 6px 2px 0px 0px;
    padding: 2px;
}

QToolBar::separator {
    width: 35px;
    height: ${length.icon.toolbar};
    color: red;
}

QToolBar#MapFrameToolBar::separator {
    width: 12px;
}

QToolBar#ToolBar_PreferenceDialog {
    qproperty-iconSize: 32px 32px;
    text-align: center;
}

QToolBar#InspectorToolToolbar,
QToolBar[inspectorToolbar="true"] {
    background-color: ${color.window};
    border-bottom: 1px solid ${color.light};
    margin: 0px;
    padding: 2px;
    padding-left: 6px;
/*    spacing: 4px;*/
    min-height: 32px;
    qproperty-iconSize: 16px 16px;
}

QToolButton#InspectorToolToolbar {
    margin: 6px;
    padding: 0px;
    margin-bottom: 0;
}


QToolButton#ToolButton_PreferenceDialog {
    min-width: 80px;
    margin: 6px;
    padding: 4px;
    margin-bottom: 10px;
}

/* ==== TOOLTIP ==== */
/* Tooltips: Außenform/Transparenz kommen zusätzlich vom TrenchBroomProxyStyle.
   Länge radius.tooltip in theme.json steuert dessen gerundeten Rahmen. */

QToolTip {
    border: 1px solid ${color.midlight};
    background-color: ${color.dark};
    color: ${color.text.highlighted};
    font-size: ${length.font.small};
    padding: 2px;
    border-radius: ${length.radius.tooltip};
}

/* ==== MENU ==== */
/* Kontextmenüs und Dropdown-Menüs der Menüleiste: Zeilen, Auswahl und Trenner.
   Der Popup-Rahmen wird zusätzlich vom TrenchBroomProxyStyle geglättet; der Radius
   kommt aus length.radius.menu. Menü-Icons/Shortcuts steuern die Preferences. */

QMenu {
    background-color: ${color.base};
    border: 1px solid ${color.midlight};
    color: ${color.text.button};
    margin: 0px;
    font-size: ${length.font.ui};
    border-radius: ${length.radius.menu};
    padding: 4px;
    padding-top: 8px;
    padding-bottom: 8px;
}

QMenu::item {
    padding: 3px ${length.margin.wide} 3px ${length.margin.wide};
    margin: 0px;
    border: 1px solid transparent;
    min-width: 130px;
    min-height: 15px;
}

QMenu::item:selected {
    background-color: ${color.highlight};
    color: ${color.text.highlighted};
    border-radius: 4px;
}

QMenu::item:disabled {
    font-style: italic;
    color: ${color.text.disabled};
    border: 1px solid transparent;
}

QMenu::separator {
    min-width: 90px;
    min-height: 24px;
    height: ${length.margin.narrow};
    margin: ${length.margin.medium} ${length.margin.wide} ${length.margin.medium} ${length.margin.wide};
    background: ${color.midlight};
}

/* ==== COMPACT CONTROLS ==== */
/* Kompakte Ausnahmen: Textur-Browser, Launch Game, View Settings, Advanced-
   Preferences und die drei Dateiauswahl-Schaltflächen des Welcome-Fensters. */
QComboBox#TextureBrowser_smallComboBox {
    padding: 3px 3px 3px 2px;
    min-width: 60px;
    min-height: 18px;
}

QPushButton#TextureBrowser_smallPushButton {
    padding: 3px ${length.margin.medium} 3px ${length.margin.medium};
    min-width: 40px;
    min-height: 18px;
}

QPushButton#LaunchGameEngineDialog_smallPushButton {
    padding: 3px ${length.margin.medium} 3px ${length.margin.medium};
    min-width: 40px;
    min-height: 18px;
}

QPushButton#ViewEditor_smallPushButton {
    padding: 3px ${length.margin.medium} 3px ${length.margin.medium};
    min-width: 65px;
    min-height: 18px;
}

QPushButton#PreferencesPreferencePane_smallPushButton {
    padding: 3px ${length.margin.medium} 3px ${length.margin.medium};
    min-height: 18px;
}

QPushButton#PreferenceEditDialog_toolButton {
    padding: 3px ${length.margin.medium} 3px ${length.margin.medium};
    min-width: 50px;
    min-height: 18px;
}

QPushButton#WelcomeWindow_Button_Left {
    padding: 6px;
    border-radius: 6px;
    border-right: 1px solid ${color.base};
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

QPushButton#WelcomeWindow_Button_Middle {
    padding: 6px;
    border-radius: 6px;
    border-left: 1px solid ${color.base};
    border-right: 1px solid ${color.base};
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

QPushButton#WelcomeWindow_Button_Right {
    padding: 6px;
    border-radius: 6px;
    border-left: 1px solid ${color.base};
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

/* ==== TREE-WIDGET ==== */
/* Allgemeine Baumansichten, u.a. Prefab- und Dateilisten. Der Layer-Baum ergänzt
   bzw. ersetzt diese Darstellung durch die Regeln unter LAYER TREE. */

QTreeView {
    background-color: ${color.base};
    border: none;
    color: ${color.text};
    gridline-color: ${color.midlight};
    border-radius: 0px;
}

QTreeView:disabled {
    color: ${color.text.disabled};
}

QTreeView:selected {
    background-color: ${color.highlight};
    color: ${color.text.highlighted};
}

QTreeView:focus {
    border: none;
}

QTreeView::item:pressed {
    background-color: ${color.toolbutton.checked};
}

QTreeView::item:selected:active {
    background-color: ${color.toolbutton.checked};
}

QTreeView::item:selected:!active {
    color: ${color.text.disabled};
    background-color: ${color.base};
}

/* ==== TAB-WIDGET ==== */
/* Allgemeine Tabs in Dialogen, darunter Toolbar settings/Elements und View Settings.
   InspectorToolTabs sind gestapelte Inspector-Werkzeuge. InfoPanelTabBar/-TabWidget
   gehören zum unteren Informations-/Konsolenbereich des Editorfensters. */
QTabWidget::pane {
    border: none;
    margin-top: 0;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabWidget#InfoPanelTabWidget::tab-bar {
    alignment: left;
}

QTabBar {
    margin-bottom: 0px;

}

QTabBar::tab {
    background-color: ${color.window};
    color: ${color.text};
    border: none;
    min-height: 22px;
    min-width: 70px;
    margin: 0px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: ${length.font.subtitle};
}

QTabBar::tab:hover {
    background-color: ${color.midlight};
}

QTabBar::tab:selected {
    background-color: ${color.light};
    color: ${color.text.highlighted};
}

QTabBar#InspectorToolTabs {
    min-height: 18px;
    max-height: 28px;
}

QTabBar#InspectorToolTabs::tab {
    background-color: rgba(0, 0, 0, 0);
    color: ${color.text};
    border: none;
    margin-top: 0px;
    margin-bottom: 0;
    padding: 2px;
    padding-bottom: 4px;
    padding-top: 4px;
    min-height: 16px;
    max-height: 28px;
    font-size: ${length.font.subtitle};
}

QTabBar#InspectorToolTabs::tab:hover {
    background-color: ${color.midlight};
}

QTabBar#InspectorToolTabs::tab:selected {
    color: ${color.text.highlighted};
    background-color: ${color.light};
    text-style: bold;
}

QTabBar#InfoPanelTabBar::tab {
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    min-height: 14px;
    min-width: 50px;
    padding: 2px;
    margin-right: 1px;
    margin-left: 0px;
    margin-bottom: 0px;
    margin-top: 2px;
    font-size: ${length.font.small};
}

QTabBar#InfoPanelTabBar::tab:selected {
    border-bottom: 1px solid ${color.highlight};
}

/* ==== SCROLL BAR ==== */
/* Horizontale/vertikale Scrollleisten in Listen, Bäumen und Scroll-Panes.
   handle ist der Schieber; add-line/sub-line sind die Endbereiche. */

QScrollBar:horizontal {
    height: 10px;
    border: none;
    border-radius: 4px;
    margin-bottom: 0px;
    background-color: ${color.base};
}

QScrollBar:vertical {
    width: 10px;
    margin-right: 0px;
    border: none;
    border-radius: 4px;
    background-color: ${color.base};
}

QScrollBar::handle {
    margin: 1px;
    border-radius: 2px;
}

QScrollBar::handle:horizontal {
    background-color: ${color.midhalf};
    border: 2px solid ${color.midhalf};
    max-height: 10px;
    min-width: 64px;
}

QScrollBar::handle:horizontal:hover {
    background-color: ${color.light};
    border: 2px solid ${color.light};
}

QScrollBar::handle:horizontal:focus {
    background-color: ${color.light};
    border: 2px solid ${color.light};
}

QScrollBar::handle:vertical {
    background-color: ${color.midhalf};
    border: 2px solid ${color.midhalf};
    min-height: 64px;
    max-width: 10px;
    padding-left: 0px;
    padding-top: 4px;
    padding-bottom: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: ${color.light};
    border: 2px solid ${color.light};
}

QScrollBar::handle:vertical:focus {
    background-color: ${color.light};
    border: 2px solid ${color.light};
}

QScrollBar::add-line:horizontal {
    margin: 0px 0px 0px 0px;
    height: 2px;
    width: 2px;
    max-width: 2px;
    max-height: 2px;
}

QScrollBar::add-line:vertical {
    margin: 0px 0px 0px 0px;
    height: 2px;
    width: 2px;
    max-width: 2px;
    max-height: 2px;
}

QScrollBar::sub-line:horizontal {
    margin: 0px 0px 0px 0px;
    height: 2px;
    width: 2px;
    max-width: 2px;
    max-height: 2px;
}

QScrollBar::sub-line:vertical {
    margin: 0px 0px 0px 0px;
    height: 2px;
    width: 2px;
    max-width: 2px;
    max-height: 2px;
}

/* ==== TOOLBUTTON ==== */
/* Gemeinsame Icon-Buttons: Hover, gedrückt, aktiviert und deaktiviert.
   popupMode 0/1/2 unterscheidet verzögertes Menü, geteilten Button und Sofortmenü.
   toolButton_borderless ist die rahmenlose Variante. Die nachfolgenden Inspector-
   Selektoren gelten ebenso für die Action-/Toolbar-Verwaltung. */

QToolButton {
    color: ${color.text};
    border-radius: 2px;
    padding: 3px;
    border: 1px solid ${color.midlight};
    margin-left: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
}

QToolButton:disabled {
    color: ${color.mid};
}

QToolButton:checked {
      background-color: ${color.midlight};
      border-color: ${color.midlight};
      color: ${color.text.highlighted};
}

QToolButton:hover {
    color: ${color.text};
}

QToolButton:pressed {
    background-color: ${color.mid};
}

QToolButton:selected {
    background: ${color.dark};
    color: ${color.text};
}

QToolButton[popupMode="0"] {
    padding-right: 2px;
}

QToolButton[popupMode="1"] {
    padding-right: 20px;
}

QToolButton[popupMode="1"]::menu-button {
    border: none;
}

QToolButton[popupMode="2"] {
    padding-right: 2px;
}

QToolButton::menu-button {
    padding: 2px;
    border-radius: 4px;
    width: 12px;
    border: none;
    outline: none;
}

QToolButton::menu-button:hover {
    border: 1px solid ${color.midlight};
}

QToolButton::menu-button:checked:hover {
    border: none;
}

QToolButton#toolButton_borderless {
    padding: 0px;
    margin: 0px;
    border: none;
    qproperty-iconSize: 16px 16px;
}

QToolButton#toolButton_borderless:checked {
    background-color: transparent;
    border: none;
}

QToolButton#toolButton_borderless::menu-indicator {
    image: none;
}

QToolBar#InspectorToolToolbar QToolButton,
QToolBar[inspectorToolbar="true"] QToolButton,
QWidget#InspectorWindowTitle QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    margin: 0;
    padding: 4px;
    min-width: 16px;
    min-height: 16px;
    qproperty-iconSize: 16px 16px;
}

QToolBar#InspectorToolToolbar QToolButton[layerTreeControl],
QToolBar[inspectorToolbar="true"] QToolButton[layerTreeControl] {
    padding: 0px;
}

QToolBar#InspectorToolToolbar QPushButton,
QToolBar[inspectorToolbar="true"] QPushButton {
    background-color: transparent;
    border: 1px solid ${color.midlight};
    border-radius: 4px;
    margin: 0;
    padding: 3px 4px;
    min-width: 20px;
    min-height: 16px;
    font-size: ${length.font.small};
}

QToolBar#InspectorToolToolbar,
QToolBar[inspectorToolbar="true"] {
    border-top: none;
    margin: 0;
}

QToolBar#InspectorToolToolbar QToolButton:hover:enabled,
QToolBar[inspectorToolbar="true"] QToolButton:hover:enabled,
QToolBar#InspectorToolToolbar QPushButton:hover:enabled,
QToolBar[inspectorToolbar="true"] QPushButton:hover:enabled,
QWidget#InspectorWindowTitle QToolButton:hover:enabled {
    background-color: ${color.midlight};
}

QToolBar#InspectorToolToolbar QToolButton:pressed,
QToolBar[inspectorToolbar="true"] QToolButton:pressed,
QToolBar#InspectorToolToolbar QPushButton:pressed,
QToolBar[inspectorToolbar="true"] QPushButton:pressed,
QWidget#InspectorWindowTitle QToolButton:pressed {
    background-color: ${color.mid};
}

QToolBar#InspectorToolToolbar QToolButton:checked,
QToolBar[inspectorToolbar="true"] QToolButton:checked,
QToolBar#InspectorToolToolbar QPushButton:checked,
QToolBar[inspectorToolbar="true"] QPushButton:checked {
    background-color: ${color.dark};
    border-color: ${color.midlight};
    color: ${color.text.highlighted};
}

QToolBar#InspectorToolToolbar QToolButton:disabled,
QToolBar[inspectorToolbar="true"] QToolButton:disabled,
QToolBar#InspectorToolToolbar QPushButton:disabled,
QToolBar[inspectorToolbar="true"] QPushButton:disabled {
    color: ${color.text.disabled};
}

QToolBar#InspectorToolToolbar QToolButton[popupMode="1"],
QToolBar[inspectorToolbar="true"] QToolButton[popupMode="1"] {
    padding-right: 22px;
}

QToolBar#InspectorToolToolbar QToolButton[popupMode="1"]::menu-button,
QToolBar[inspectorToolbar="true"] QToolButton[popupMode="1"]::menu-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    padding: 0;
    border: none;
    border-left: 1px solid ${color.mid};
    border-radius: 0;
}

QToolBar#InspectorToolToolbar QComboBox,
QToolBar[inspectorToolbar="true"] QComboBox {
    background-color: ${color.dark};
    font-size: ${length.font.small};
    margin: 0;
    padding: 0;
}

QToolBar#InspectorToolToolbar QCheckBox,
QToolBar[inspectorToolbar="true"] QCheckBox {
     background-color: ${color.dark};
    margin: 0;
    padding: 0;
    font-size: ${length.font.small};
}

/* ==== PUSHBUTTON ==== */
/* Allgemeine Text-Schaltflächen (z.B. Apply, Cancel, Choose icon...). FolderSelect
   ist die kompakte Dateiauswahl-Variante. Icon-Helligkeit wird separat gestaltet. */

QPushButton {
    background-color: ${color.button};
    color: ${color.text.button};
    border-radius: 2px;
    border: 1px solid ${color.light};
    outline: none;
    min-width: 60px;
    min-height: ${length.font.ui};
    padding: 3px 8px 3px 8px;
    margin: 1px;
}

QPushButton#FolderSelect {
    background-color: ${color.button};
    color: ${color.text.button};
    border-radius: 1px;
    border: 1px solid ${color.light};
    min-width: 25px;
    min-height: ${length.font.ui};
    padding: 3px 8px 3px 8px;
    margin: 1px;
    outline-color: ${color.midlight};
    outline: 3px;
}

QPushButton:disabled {
    background-color: ${color.dark};
    border: 1px solid ${color.midlight};
    color: ${color.text.disabled};
}

QPushButton:checked {
    background-color: ${color.highlight};
}

QPushButton:checked:disabled {
    background-color: ${color.highlight.dark};
    color: ${color.text.disabled};
}

QPushButton:checked:selected {
    background: ${color.highlight};
}

QPushButton:pressed {
    background-color: ${color.dark};
    border: 1px solid ${color.base};
}

QPushButton:selected {
    border: 2px solid ${color.highlight};
    color: ${color.text};
}

/* ==== VIEW SETTINGS ==== */
/* Der aus dem MapEditor geöffnete View-Settings-Dialog (nicht Preferences -> View).
   Die Regeln bestimmen Dialogfläche, seine Kategorien und den Reset-Button;
   die eigentlichen Checkboxen/Zahlenfelder verwenden die gemeinsame Basis oben. */
QWidget#ViewEditor {
    min-width: 700px;
    min-height: 480px;
    max-width: 1000px;
    max-height: 640px;
}

QTabWidget#ViewSettingsTabs::pane {
    border: none;
}

QWidget#ViewSettingsDisplay, QWidget#ViewSettingsGeometry, QWidget#ViewSettingsObjects {
    background: ${color.window};
}

QWidget#ViewSettingsEntityDefinitions {
    min-width: 230px;
}

QPushButton#ViewSettingsReset {
    margin: 4px 8px;
}

/* ==== SPECIALIZED WIDGETS ==== */
/* ColorSwatch: Farbmuster, CompilationTaskCard/-Title: Kompilier-Aufgaben,
   EntityDefinitionExternalPath: Pfad zur eingebauten/externen Entity-Definition,
   CrashLogView/CrashStackTraceView: Textbereiche im Crash-Dialog. */
QWidget#ColorSwatch {
    min-width: 20px;
    min-height: 15px;
    border: 1px solid ${color.midlight};
    border-radius: 3px;
}

QWidget#CompilationTaskCard {
    background-color: ${color.highlight.dark};
}

QLabel#CompilationTaskTitle {
    background-color: ${color.midlight};
    padding: ${length.margin.narrow.v} 0 ${length.margin.narrow.v} ${length.margin.medium.h};
}

QLabel#EntityDefinitionExternalPath[useBuiltin="true"] {
    color: ${color.text.disabled};
    font-style: italic;
}

QLabel#EntityDefinitionExternalPath[useBuiltin="false"] {
    color: ${color.text};
    font-style: normal;
}

QTextEdit#CrashLogView, QTextEdit#CrashStackTraceView {
    color: ${color.text};
    background-color: ${color.base};
    margin: 0;
    padding: 0;
}


/* ==== BRUSH SHAPE TOOL ==== */
/* Parameterleiste des Create-Tools über dem MapEditor (z.B. Segmente, Radius,
   Rock-Seed). Die Auswahl der Form befindet sich in den MapEditor-Toolbars unten. */
QWidget#ShapeToolPage {
    padding: 2px;
}

QStackedWidget#ShapeToolParameters {
    border: none;
    background: transparent;
}

QWidget#ShapeToolPage QSpinBox, QWidget#ShapeToolPage QDoubleSpinBox {
    min-width: 64px;
}

QWidget#ShapeToolPage QSpinBox#ShapeRockSeed {
    min-width: 110px;
}

QWidget#ShapeToolPage QToolButton {
    qproperty-iconSize: 20px 20px;
    padding: 3px;
}

QWidget#ShapeToolPage QToolButton:checked {
    background-color: ${color.midlight};
    border: 1px solid ${color.highlight};
}

QWidget#ShapeToolPage QPushButton#ShapeToolApply {
    padding: 4px 10px;
}


/* ==== MAPEDITOR TOOLBARS (Left / Top / Right / Bottom) ==== */
/* EditorToolbar ist eine frei konfigurierte Toolbar direkt über der Map-Ansicht.
   position wählt die Kante. Die qproperty-Geometriewerte gehen in die Platzberechnung
   ein, einschließlich Verkleinerung/Ausblenden bei Platzmangel. EditorToolbarButton
   erbt Icon, Tooltip und Aktivierung von seiner Action. Die Standard-Toolbar zeigt
   die Create-Formen auch im Select-Modus. */
/* Editor toolbars: common geometry, with a separate visual style per edge. */
QFrame#EditorToolbar {
    qproperty-panelPadding: 6;
    qproperty-buttonPadding: 4;
    qproperty-buttonSpacing: 4;
    qproperty-edgeMargin: 12;
    qproperty-toolbarGap: 6;
    border: 1px solid ${color.mid};
    border-radius: ${length.radius.border};
}

QFrame#EditorToolbar[position="left"] { background-color: ${color.base}; }
QFrame#EditorToolbar[position="right"] { background-color: ${color.base}; }
QFrame#EditorToolbar[position="top"] { background-color: ${color.base}; }
QFrame#EditorToolbar[position="bottom"] { background-color: ${color.base}; }
QFrame#EditorToolbar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: ${length.radius.border};
    padding: 0;
    margin: 0;
    min-width: 0;
    min-height: 0;
}

QFrame#EditorToolbar QToolButton:hover { background-color: ${color.base.alternate}; border-color: ${color.mid}; }
QFrame#EditorToolbar QToolButton:checked { background-color: ${color.highlight}; color: ${color.text.highlighted}; }
QFrame#EditorToolbar QToolButton:pressed { background-color: ${color.highlight}; }
QFrame#EditorToolbarSeparator { color: ${color.mid}; background: transparent; border: none; }

/* ==== EDITOR CUSTOMIZATION PREFERENCES ==== */
/* Preferences -> Editor Actions / Editor Toolbar: rechte Formularbreite,
   Shortcut-Feld und linke Listen bzw. die Elements-Liste. Die Toolbars nutzen
   inspectorToolbar="true"; Checkboxen/SpinBoxen/Dropdowns nutzen die Basis oben.
   EditorIconGrid/-Preview/-Name/-Count gehören zum Dialog Choose icon.... */

/* Shared preference form width; FormWithSectionsLayout supplies the same
   section headers and field margins used by View preferences. */
QWidget[preferenceForm="true"] {
    max-width: 760px;
}
QKeySequenceEdit#EditorActionShortcut {
    max-width: 220px;
}

QListWidget#EditorConfigurationList, QListWidget#EditorToolbarAssignedActions { border: none; }
QListWidget#EditorConfigurationList::item, QListWidget#EditorToolbarAssignedActions::item {
    min-height: 28px;
    padding: 3px 6px;
    border-radius: ${length.radius.border};
}
QLabel#EditorConfigurationError { color: ${color.text}; padding: 8px; background: ${color.base.alternate}; border-radius: ${length.radius.border}; }

/* SVG picker tiles inherit list surfaces and selection states above. */
QListWidget#EditorIconGrid {
    border: none;
    qproperty-iconSize: 40px 40px;
    qproperty-gridSize: 112px 86px;
}

QListWidget#EditorIconGrid::item {
    padding: 4px;
    border-radius: ${length.radius.border};
}

QListWidget#EditorIconGrid::item:hover:!selected {
    background-color: ${color.base.alternate};
}

QLabel#EditorIconPreview {
    min-width: 48px; max-width: 48px;
    min-height: 48px; max-height: 48px;
    background-color: ${color.base};
    border: 1px solid ${color.midlight};
    border-radius: ${length.radius.border};
    padding: 3px;
}

QLabel#EditorIconName {
    color: ${color.text.highlighted};
}

QLabel#EditorIconCount {
    color: ${color.text.detail};
    font-size: ${length.font.small};
}

/* Legacy-Formenpalette: kompatible Regeln für BrushShapePalette. Die aktuelle
   MapEditor-Ansicht verwendet die konfigurierbaren EditorToolbar-Regeln oben. */
QFrame#BrushShapePalette {
    qproperty-edgeMargin: 12;
    qproperty-panelPadding: 6;
    qproperty-buttonSpacing: 4;
    qproperty-overlayOpacity: 0.94;
    background-color: ${color.shapePalette.background};
    border: 1px solid ${color.shapePalette.border};
    border-radius: 10px;
}

QWidget#BrushShapePaletteContent, QScrollArea#BrushShapePaletteScroll,
QScrollArea#BrushShapePaletteScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#BrushShapePalette QToolButton {
    qproperty-iconSize: 28px 28px;
    padding: 5px;
    margin: 0;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
}

QFrame#BrushShapePalette QToolButton:hover {
    background-color: ${color.shapePalette.hover.background};
    border-color: ${color.shapePalette.hover.border};
}

QFrame#BrushShapePalette QToolButton:checked {
    background-color: ${color.midlight};
    border-color: ${color.highlight};
}

QFrame#BrushShapePalette QToolButton:pressed {
    background-color: ${color.highlight};
}

/* Palette cells display actual map colors; their selected outline and geometry
   are UI presentation and can be changed here. */
TrenchBroom--View--ColorTable {
    qproperty-cellSize: 15;
    qproperty-cellSpacing: 2;
    qproperty-selectionColor: #ff0000;
    qproperty-selectionWidth: 1;
}

/* ==== SHARED ICON SIZES ==== */
/* These are presentation sizes. User-configured sizes of editor toolbars,
   Layer nodes and Prefab zoom continue to come from their controls. */
QToolButton#toolButton_borderless { qproperty-iconSize: 16px 16px; }
QToolButton#toolButton_borderless[popupButton="true"] { qproperty-iconSize: 12px 12px; }
QListWidget#EditorConfigurationList, QListWidget#EditorToolbarAssignedActions { qproperty-iconSize: 24px 24px; }
QPushButton#WelcomeWindow_Button_Left,
QPushButton#WelcomeWindow_Button_Middle,
QPushButton#WelcomeWindow_Button_Right { qproperty-iconSize: 20px 20px; }
